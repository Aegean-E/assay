{
  "schema": 1,
  "name": "payments-guardrail",
  "default": "allow",
  "rules": [
    {
      "id": "block-shell",
      "action": "shell.*",
      "effect": "deny"
    },
    {
      "id": "block-crypto-transfers",
      "action": "payments.crypto.*",
      "effect": "deny"
    },
    {
      "id": "transfer-ceiling",
      "action": "payments.*",
      "effect": "deny",
      "amount_over": 50000
    },
    {
      "id": "approve-high-transfers",
      "action": "payments.transfer",
      "effect": "require_approval",
      "amount_over": 5000
    },
    {
      "id": "approve-wire-transfers",
      "action": "payments.wire",
      "effect": "require_approval"
    }
  ]
}
